{
  "_comment": "LayerDiffuse SDXL workflow — huchenlei/ComfyUI-layerdiffuse + SDXL base 1.0. RGBA native transparent 출력. DreamShaperXL Turbo 와 호환 X (distillation 으로 LayerDiffuse 의 vae_transparent_decoder 가 RGB 디테일 복원 못 함, silhouette 만 출력) — 본 워크플로는 stabilityai/stable-diffusion-xl-base-1.0.safetensors 의 standard 모델 사용. KSampler: steps=20 / cfg=8.0 / sampler euler / scheduler normal (LayerDiffuse 검증된 조합). LayeredDiffusionApply config=\"SDXL, Conv Injection\". LayeredDiffusionDecodeRGBA sd_version=\"SDXL\" + sub_batch_size=16. 표준 SDXL 노드 id 유지 (positive=6, negative=7, sampler=3, latent=5, model_apply=10, decode=11).",
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 22222,
      "steps": 20,
      "cfg": 8.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0,
      "model": ["10", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    }
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sd_xl_base_1.0.safetensors"
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "PLACEHOLDER POSITIVE PROMPT",
      "clip": ["4", 1]
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "PLACEHOLDER NEGATIVE PROMPT",
      "clip": ["4", 1]
    }
  },
  "10": {
    "class_type": "LayeredDiffusionApply",
    "inputs": {
      "model": ["4", 0],
      "config": "SDXL, Conv Injection",
      "weight": 1.0
    }
  },
  "11": {
    "class_type": "LayeredDiffusionDecodeRGBA",
    "inputs": {
      "samples": ["3", 0],
      "images": ["8", 0],
      "sd_version": "SDXL",
      "sub_batch_size": 16
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["3", 0],
      "vae": ["4", 2]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "ComfyUI_LayerDiffuse",
      "images": ["11", 0]
    }
  }
}
