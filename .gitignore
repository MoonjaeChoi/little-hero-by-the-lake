# ============================================================
# Little Hero by the Lake / Unity Project .gitignore
#
# 구성:
#   1. Unity (GitHub 공식 Unity.gitignore 기반)
#   2. Global / macOS
#   3. Global / Xcode (iOS 빌드)
#   4. Global / IDE (VSCode, IntelliJ, Rider)
#   5. 프로젝트 추가 (빌드 산출물, 비밀, Claude Code)
#
# 출처: https://github.com/github/gitignore/blob/main/Unity.gitignore
# ============================================================


# ============================================================
# 1. Unity (공식 템플릿)
# ============================================================
.utmp/
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
*.log

# Blender — *.blend1 자동 백업은 커밋 불필요
*.blend1
*.blend1.meta

# MemoryCaptures — 용량 크고 민감한 데이터 포함 가능
/[Mm]emoryCaptures/

# Unity 자동 복구 폴더 (비정상 종료 후 자동 생성)
**/_Recovery/
**/_Recovery.meta

# Recordings — 용량 큼
/[Rr]ecordings/

# Asset Store Tools 플러그인을 무시하려면 주석 해제
# /[Aa]ssets/AssetStoreTools*

# JetBrains Rider 자동 생성 플러그인
/[Aa]ssets/Plugins/Editor/JetBrains*

# Rider 개인 레이어 설정
*.DotSettings.user

# Visual Studio 캐시
.vs/

# Gradle 캐시 (Android 빌드)
.gradle/

# 자동 생성된 솔루션/프로젝트 파일
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity 생성 메타 (위 무시 패턴 보완)
*.pidb.meta
*.pdb.meta
*.mdb.meta

# 안전장치: Unity .meta 파일은 절대 무시되면 안 됨 (반드시 커밋)
!*.meta

# 단, _Recovery 자동 복구 폴더의 .meta 는 다시 무시 (위 !*.meta 보다 뒤에 두어 우선)
**/_Recovery.meta


# ============================================================
# 2. Global / macOS
# ============================================================
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent


# ============================================================
# 3. Global / Xcode (iOS 빌드 시 생성)
# ============================================================
xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM


# ============================================================
# 4. Global / IDE (선택적)
# ============================================================
# VSCode / Cursor
.vscode/

# IntelliJ / Rider
.idea/
*.iml


# ============================================================
# 5. 프로젝트 추가 - 빌드 산출물
# ============================================================
*.apk
*.aab
*.unitypackage
*.app


# ============================================================
# 6. 프로젝트 추가 - 비밀 / 환경 변수
# ============================================================
.env
.env.local
secrets.json
*.keystore
*.mobileprovision
*.p12


# ============================================================
# 7. Claude Code 로컬 설정 (선택)
# ============================================================
.claude/


# ============================================================
# 8. MCP / 디버깅 산출물
# ============================================================
LittleHero/Assets/Screenshots/
LittleHero/Assets/Screenshots.meta


# ============================================================
# 9. Phase G2 아트 raw references (생성 후 선별 전 산출물)
# ============================================================
# References/ 는 ComfyUI/DreamShaperXL 가 생성한 raw PNG 후보들의 작업장.
# 셀렉션 후 채택한 PNG 만 Generated_v2/ 등 정식 위치로 이동/commit.
# Reference 자체는 ~186MB 이며 repo 비대화 원인이라 untracked 유지.
LittleHero/Assets/_Project/Art/References/
LittleHero/Assets/_Project/Art/References.meta
LittleHero/Assets/_Project/Art/Generated_v2.meta
